# Copy this file to ".env" (next to docker-compose.yml) and fill in EVERY value.
# ".env" holds secrets: never commit it, never send it to anyone, keep a copy somewhere safe (a password manager).

# ---- Addresses (the DNS records of both must point to this server) ----
WEB_DOMAIN=rentox.az
API_DOMAIN=api.rentox.az

# ---- Database ----
# A long random password. Make one with:  openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Keys of the API ----
# Long random texts. Make them with:  openssl rand -base64 48
# Keep the same JWT key and OTP key when you move to another server, or everybody is signed out.
JWT_SIGNING_KEY=
OTP_HASHING_KEY=
# The phone number of the owner (SuperAdmin), in the form +994501234567
SUPER_ADMIN_PHONE=

# ---- Image library licence ----
# The key from https://sixlabors.com/pricing/ (the free Community licence is for eligible applicants).
SIXLABORS_LICENSE_KEY=

# ---- Error tracking (optional) ----
# The address (DSN) of a project in Sentry (sentry.io) or the self-hosted GlitchTip. Empty = errors only stay in the logs.
SENTRY_DSN=

# ---- Push notifications (needs deploy/secrets/firebase.json from your Firebase project) ----
PUSH_ENABLED=false

# ---- Backups to Cloudflare R2 (see README.md). Leave empty to switch the backup off (not recommended). ----
# Example: s3:https://<account id>.r2.cloudflarestorage.com/rentox-backup
RESTIC_REPOSITORY=
# The password that encrypts the backups. WITHOUT IT THE BACKUPS CANNOT BE OPENED: keep a copy outside this server.
RESTIC_PASSWORD=
# An R2 API token that may use ONLY the rentox-backup bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The hour (Baku time) the backup runs, 0-23
BACKUP_HOUR=3
# Optional: an address that is called after each good backup (a monitor such as healthchecks.io tells you when it stops)
BACKUP_HEALTHCHECK_URL=
