# Two addresses:
#   {$WEB_DOMAIN}  the website (and the live connections, which go straight to the API)
#   {$API_DOMAIN}  the API, for the mobile app
# Caddy gets and renews the HTTPS certificates by itself. The domains' DNS records must point to this server first.
#
# The visitor's real address is passed on (X-Real-IP / X-Forwarded-For): the API's per-address limits (one-time
# codes, sign-in) need it. The headers from the visitor are replaced, never trusted.
#
# Behind Cloudflare (the orange cloud) every request comes from a Cloudflare address, and the visitor's own address
# is in CF-Connecting-IP. Caddy believes that header only when the request really comes from one of Cloudflare's
# published ranges (https://www.cloudflare.com/ips-v4 and /ips-v6); from anyone else it is ignored, so nobody can
# fake their address. Without the cloud (grey), {client_ip} is simply the visitor's own address.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$WEB_DOMAIN} {
	import common

	# Live connections (messages, typing, notifications): WebSocket straight to the API.
	handle /hubs/* {
		reverse_proxy api:8080 {
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
		}
	}
}

{$API_DOMAIN} {
	import common

	request_body {
		max_size 25MB
	}

	reverse_proxy api:8080 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
	}
}
