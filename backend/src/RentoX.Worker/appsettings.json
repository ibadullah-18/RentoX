{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ListingMaintenance": {
    "IntervalMinutes": 5,
    "DeletedImageRetentionDays": 30,
    "CleanupBatchSize": 100
  },
  "PushNotifications": {
    "Enabled": false,
    "IntervalSeconds": 15,
    "BatchSize": 50,
    "MaximumAttempts": 5,
    "ProcessingTimeoutMinutes": 5
  }
}